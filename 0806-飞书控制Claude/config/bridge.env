# 飞书 <-> Claude Code 桥接服务配置
# 本文件被 lib/*.sh 与 scripts/*.sh 通过 source 加载

# 项目根目录（自动推导，不要手改）
BRIDGE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# lark-cli 使用的应用 profile（对应 cli_aafe15e337f8dbc6）
LARK_PROFILE="feishu-claude-bridge"

# 只有这个飞书 open_id 发的消息才会被执行（锁定为你本人账号）
# 来源：实际收到消息事件时的 sender_id（open_id 是按 app 区分的，
# 换一个飞书应用这个值就会变，需要重新抓一次）
ALLOWED_SENDER_OPEN_ID="ou_f4730972349be28f9ecc1c95d7f4831d"

# Claude Code 无头模式的真实可执行文件路径（不要用别名 claude，
# 因为 launchd/非交互 shell 不会加载 .zshrc 里的 alias）
CLAUDE_BIN="/Users/jiangfachang/.local/bin/claude"

# Claude Code 默认工作目录：飞书消息里可以让 Claude 自己 cd 到具体项目，
# 这里只是它的默认落脚点（cy26-projects 根目录，能看到你所有项目）
CLAUDE_WORK_DIR="/Users/jiangfachang/Code/AICoding/cy26-projects"

LOG_DIR="$BRIDGE_ROOT/logs"
VAR_DIR="$BRIDGE_ROOT/var"
SESSION_DIR="$VAR_DIR/sessions"
PID_FILE="$VAR_DIR/bridge.pid"

# 单条飞书文本消息最大长度，超过则拒绝执行（避免异常输入拖垮会话）
MAX_MESSAGE_LEN=4000
